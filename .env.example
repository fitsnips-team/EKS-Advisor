# LLM Configuration - Choose one or configure both for hybrid mode
# Option 1: OpenAI (requires API key, data sent to external service)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Ollama (local processing, maximum privacy)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM Provider Selection: "openai", "ollama", or "hybrid"
LLM_PROVIDER=ollama

# Kubernetes Configuration
KUBECONFIG=~/.kube/config
CLUSTER_NAME=my-eks-cluster

# Security Settings
ENABLE_DATA_REDACTION=true
LOCAL_PROCESSING_ONLY=true
AUDIT_LOGGING=true